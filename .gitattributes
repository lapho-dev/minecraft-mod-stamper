# Normalise line endings so Windows/Linux/macOS contributors don't churn the diff.
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# The Gradle wrapper script MUST stay LF or it fails to execute on Linux/macOS
gradlew text eol=lf

# Binaries — never touch
*.png   binary
*.jar   binary
*.ogg   binary
*.zip   binary
